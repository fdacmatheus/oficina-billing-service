# Valores locais/falsos. Copie para .env (fora do git) antes de rodar.
PORT=3002
PUBLIC_BASE_URL=http://localhost:3002
LOG_FORMAT=json

# Rastreamento OpenTelemetry (traces e logs via OTLP/HTTP). Sem esta variavel o
# SDK nao e ligado. OTEL_SERVICE_NAME padrao: billing-service.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Postgres do billing (fase-4/local/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5434
DB_USER=billing
DB_PASSWORD=billing
DB_NAME=billing
DB_SSL=false
DB_MIGRATIONS_RUN=true

# JWT HS256 compartilhado com a Lambda de autenticacao
JWT_SECRET=troque-me-local

# AWS emulada (Floci). Na AWS as credenciais vem do ambiente/IAM.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_BILLING_COMANDOS_URL=http://localhost:4566/000000000000/billing-comandos
SQS_OS_EVENTOS_URL=http://localhost:4566/000000000000/os-eventos
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_INTERVALO_MS=1000

# Gateway de pagamento: fake (padrao) ou mercadopago
MP_MODO=fake
MP_ACCESS_TOKEN=
# Chave publica do vendedor, usada pelo Card Payment Brick na pagina de checkout.
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=troque-me-local
MP_BASE_URL=https://api.mercadopago.com
MP_TIMEOUT_MS=10000
